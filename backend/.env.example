# Copy to .env (optional; the defaults work for local development)
AGENTS_URL=http://localhost:8002
AGENTS_TIMEOUT_SECONDS=30          # brief assessment (front end waits for it)
AGENT_RUN_TIMEOUT_SECONDS=180      # pipeline agents read whole documents; a model call can take a while
# Comma separated. "null" is the origin of a page opened from disk (file://); keep it for local demos only.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,null

# The case workspace ("memory"): database + files. Everything the agents ever saw or produced is here.
DATA_DIR=./data                    # coe4.db (SQLite), files/ (uploads, parsed text, images, decks), connectors/<kind>/ (demo sources)
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/coe4   # later: same tables on PostgreSQL

# Public web: the web-researcher may fetch pages named in the brief only if this is true. Off by default.
ALLOW_WEB=false
MAX_UPLOAD_MB=50
PARALLEL_SECTIONS=4

# Reading and analysis limits (defaults suit a normal laptop and a normal Foundry quota)
PARALLEL_CALLS=4                   # model calls made at the same time while reading documents and extracting evidence
MAX_VISION_PAGES=60                # pages per document that may be read by the vision model (scans, images, slides with figures)
EXTRACT_BATCH_CHARS=16000          # size of one text block handed to the evidence extractor
MAX_EXTRACT_CHARS=900000           # above this much text per report only the most relevant blocks are extracted
PASSAGE_CHARS=60000                # raw source text handed to the section analyst per section
