# Copy this file to `.env` (same folder) and fill in your Microsoft Foundry / Azure OpenAI values.
# `.env` is ignored by git. Never commit keys.

# auto  = use the model when the settings below are complete, otherwise the built-in rules (default)
# llm   = always try the model; if it fails the rules answer instead
# rules = never call a model
AGENT_MODE=auto

# Resource endpoint, e.g. https://my-resource.openai.azure.com  (or ...services.ai.azure.com / ...cognitiveservices.azure.com)
# Paste it as shown in Foundry; a trailing /openai/v1 is fine and is removed.
AZURE_OPENAI_ENDPOINT=

# Alternative to the endpoint: give the Foundry resource name and the project name and the endpoint is built for you
#   (https://<resource>.services.ai.azure.com/api/projects/<project>). The endpoint above wins when both are set.
# AZURE_AI_FOUNDRY_RESOURCE=
# AZURE_AI_PROJECT_NAME=

# Name of the model DEPLOYMENT in Foundry (not the model family), e.g. gpt-4.1
AZURE_OPENAI_DEPLOYMENT=

# How to sign in: pick ONE of the two.
# (A) API key: put it here and leave AZURE_USE_ENTRA_ID=false.
AZURE_OPENAI_API_KEY=
# (B) Your Azure identity (no key): leave the key empty and set AZURE_USE_ENTRA_ID=true.
#     The service uses the first sign-in it finds: environment, managed identity, VS Code, Azure CLI (`az login`), Azure PowerShell, azd.
#     If none is found it opens a browser tab (see AZURE_ENTRA_BROWSER). The sign-in happens once, on the first model call
#     after the service starts. To trigger it on purpose, open http://localhost:8002/health/llm
AZURE_USE_ENTRA_ID=false
# Entra ID only: allow the browser tab as the last resort (default true). Set false on a machine without a browser.
# AZURE_ENTRA_BROWSER=true
# Entra ID only: directory (tenant) id for the browser sign-in. Only needed if you have several tenants.
#     After the first browser sign-in the account is remembered in .azure-auth-record.json (next to this file), so the next
#     start signs in silently. Delete that file to sign in as someone else. No password or key is ever stored by this project.
# AZURE_TENANT_ID=

# Web search (used when a report has "Research on the web" switched on): Foundry's own web search tool, nothing else to set up.
# Tool type; the default works on the current API. Use "web_search" on newer API versions.
# AZURE_WEB_SEARCH_TOOL=web_search_preview

# Optional: a different deployment per model tier. A tier left empty uses AZURE_OPENAI_DEPLOYMENT.
#   small    = cheap, high volume (evidence extraction, screening)
#   standard = planning, research, feedback
#   strong   = analysis, verification, slides, interview
#   vision   = reads images (asset curator); must be a vision-capable model
# AZURE_OPENAI_DEPLOYMENT_SMALL=
# AZURE_OPENAI_DEPLOYMENT_STANDARD=
# AZURE_OPENAI_DEPLOYMENT_STRONG=
# AZURE_OPENAI_DEPLOYMENT_VISION=

# Only for Entra ID: token scope. The default works for Azure OpenAI resources (...openai.azure.com, ...cognitiveservices.azure.com).
# If the endpoint is a Foundry *project* URL (...services.ai.azure.com/api/projects/<name>) and you get 401 "audience" errors, use
# AZURE_OPENAI_ENTRA_SCOPE=https://ai.azure.com/.default

# Leave empty to use the current v1 API (recommended). Set it (e.g. 2024-10-21) only if your resource needs the classic API.
AZURE_OPENAI_API_VERSION=

# Seconds to wait for one model call before the rules answer instead. 20 suits the short Brief agent; the pipeline agents read whole
# documents, so use 60 to 120 for the first real tests.
LLM_TIMEOUT_SECONDS=60
